# Base
theme[main_bg]="{{ bg0 }}"
theme[main_fg]="{{ fg0 }}"
theme[title]="{{ fg0 }}"
theme[hi_fg]="{{ accent }}"
theme[selected_bg]="{{ bg2 }}"
theme[selected_fg]="{{ fg0 }}"
theme[inactive_fg]="{{ bright_black }}"
theme[graph_text]="{{ fg0 }}"
theme[meter_bg]="{{ bg2 }}"
theme[proc_misc]="{{ accent }}"
theme[div_line]="{{ bg3 }}"

# Boxes
theme[cpu_box]="{{ accent }}"
theme[mem_box]="{{ accent }}"
theme[net_box]="{{ accent }}"
theme[proc_box]="{{ accent }}"

# Graphs - Temperature
theme[temp_start]="{{ green }}"
theme[temp_mid]="{{ yellow }}"
theme[temp_end]="{{ red }}"

# Graphs - CPU/Mem/Disk/Net
