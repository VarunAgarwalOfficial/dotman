#!/usr/bin/env bash
# Apply GTK theme and Papirus folder colors — generated by dotman

gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3-dark
gsettings set org.gnome.desktop.interface color-scheme prefer-dark
gsettings set org.gnome.desktop.interface icon-theme dotman-papirus

bash ~/.local/share/icons/setup.sh
