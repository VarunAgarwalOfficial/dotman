#!/usr/bin/env bash
# Create custom papirus icon theme with accent-colored folders
# Generated by dotman — {{ theme_name }}

set -e

ACCENT="{{ accent }}"
SRC="/usr/share/icons/Papirus-Dark"
DST="$HOME/.local/share/icons/dotman-papirus"

rm -rf "$DST" || true
mkdir -p "$DST"

cat > "$DST/index.theme" << EOF
[Icon Theme]
Name=dotman-papirus
Comment=dotman Papirus icon theme with accent-colored folders
Inherits=Papirus-Dark
EOF

find "$SRC" -name "*.svg" | while read -r src_svg; do
    if grep -q "ColorScheme-Text" "$src_svg"; then
        rel="${src_svg#$SRC/}"
        dst_svg="$DST/$rel"
        mkdir -p "$(dirname "$dst_svg")"
        sed "s/\.ColorScheme-Text { color:#[0-9a-fA-F]*/.ColorScheme-Text { color:${ACCENT}/g" "$src_svg" > "$dst_svg"
    fi
done

gtk-update-icon-cache -f -t "$DST" 2>/dev/null || true