#!/usr/bin/env bash
# Spawns a new foot terminal for commands that need their own interactive session, like nvim, vim-notes, quicknotes, screenshot, or terminal-rain.

# Most of my menu scripts run inline using run_menu from menu-common. But when I need an interactive terminal session, I spawn a new foot window with this. FOOT_CLASS=floating lets me style these windows in Hyprland with fullscreen, no borders, or whatever I need.

FOOT_CLASS="floating"
PERSIST=false

# Parse flags
while [[ $# -gt 0 ]]; do
    case "$1" in
        --persist)
            PERSIST=true
            shift
            ;;
        --interactive)
            foot --app-id="$FOOT_CLASS" &
            wait $!
            exit 0
            ;;
        *)
            break
            ;;
    esac
done

# If called with no args, open an interactive shell
if [ $# -eq 0 ]; then
    foot --app-id="$FOOT_CLASS" &
    wait $!
else
    if [ "$PERSIST" = true ]; then
        # Run the command, then drop to a shell so the terminal stays open
        foot --app-id="$FOOT_CLASS" sh -c "$*; echo; echo '── Press Enter to close ──'; read" &
    else
        foot --app-id="$FOOT_CLASS" sh -c "$*" &
    fi
    wait $!
fi
